{
  "fn main": {
    "prefix": "fnmain",
    "body": [
      "fn main() {",
      "    $0",
      "}"
    ],
    "description": "entry point"
  },
  "println": {
    "prefix": "pln",
    "body": [
      "println!(\"${1:{}}\", ${2:value});"
    ],
    "description": "println with a value"
  },
  "unittest": {
    "prefix": "test",
    "body": [
      "#[test]",
      "fn ${1:name}() {",
      "    ${2:assert_eq!(${3:left}, ${4:right});}",
      "}"
    ],
    "description": "unit test"
  },
  "test module": {
    "prefix": "testmod",
    "body": [
      "#[cfg(test)]",
      "mod tests {",
      "    use super::*;",
      "",
      "    #[test]",
      "    fn ${1:name}() {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "test module"
  },
  "assert_eq": {
    "prefix": "aeq",
    "body": [
      "assert_eq!(${1:left}, ${2:right});"
    ],
    "description": "assert equality"
  },
  "struct+derive": {
    "prefix": "structd",
    "body": [
      "#[derive(Debug, Clone, PartialEq)]",
      "struct ${1:Name} {",
      "    ${2:field}: ${3:Type},",
      "}"
    ],
    "description": "struct with derives"
  },
  "enum+derive": {
    "prefix": "enumd",
    "body": [
      "#[derive(Debug, Clone, PartialEq)]",
      "enum ${1:Name} {",
      "    ${2:Variant},",
      "}"
    ],
    "description": "enum with derives"
  },
  "impl block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "    fn ${2:new}(${3}) -> Self {",
      "        ${0:todo!()}",
      "    }",
      "}"
    ],
    "description": "impl block"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:pattern} => ${3:result},",
      "    _ => ${0:todo!()},",
      "}"
    ],
    "description": "match expression"
  },
  "let mut": {
    "prefix": "letm",
    "body": [
      "let mut ${1:name} = ${2:value};"
    ],
    "description": "mutable binding"
  },
  "vec": {
    "prefix": "vec",
    "body": [
      "let ${1:name} = vec![${2}];"
    ],
    "description": "vector"
  },
  "result fn": {
    "prefix": "fnresult",
    "body": [
      "fn ${1:name}() -> Result<${2:()}, Box<dyn std::error::Error>> {",
      "    ${0:Ok(())}",
      "}"
    ],
    "description": "fn returning Result"
  }
}
