;;; neon-flux-theme.el --- Dark navy theme with cyan accents -*- lexical-binding: t; -*-

;; Version: 0.1.0
;; Package-Requires: ((emacs "29.1"))
;; Keywords: faces, theme

;;; Commentary:
;; Palette tokens are substituted from Neon Flux's canonical palette by Nix.

;;; Code:

(deftheme neon-flux "Dark navy surfaces with cyan, violet, and pink accents.")

(let ((canvas "@canvas@")
      (surface "@surface@")
      (raised "@raised@")
      (current-line "@currentLine@")
      (border "@border@")
      (selection "@selection@")
      (text "@text@")
      (muted "@muted@")
      (line-number "@lineNumber@")
      (accent "@accent@")
      (accent-bright "@accentBright@")
      (structure "@structure@")
      (purple "@purple@")
      (hot "@hot@")
      (info "@info@")
      (success "@success@")
      (warning "@warning@")
      (error "@error@")
      (comment "@comment@"))
  (custom-theme-set-faces
   'neon-flux
   `(default ((t (:background ,canvas :foreground ,text))))
   `(cursor ((t (:background ,accent))))
   `(fringe ((t (:background ,canvas :foreground ,muted))))
   `(vertical-border ((t (:foreground ,border))))
   `(window-divider ((t (:foreground ,border))))
   `(window-divider-first-pixel ((t (:foreground ,border))))
   `(window-divider-last-pixel ((t (:foreground ,border))))
   `(region ((t (:background ,selection :foreground ,text))))
   `(highlight ((t (:background ,raised))))
   `(hl-line ((t (:background ,current-line))))
   `(line-number ((t (:background ,canvas :foreground ,line-number))))
   `(line-number-current-line ((t (:background ,current-line :foreground ,accent))))
   `(minibuffer-prompt ((t (:foreground ,accent :weight bold))))
   `(link ((t (:foreground ,info :underline t))))
   `(link-visited ((t (:foreground ,purple :underline t))))
   `(shadow ((t (:foreground ,muted))))
   `(success ((t (:foreground ,success))))
   `(warning ((t (:foreground ,warning))))
   `(error ((t (:foreground ,error :weight bold))))
   `(match ((t (:background ,selection :foreground ,accent-bright :weight bold))))
   `(isearch ((t (:background ,accent :foreground ,canvas :weight bold))))
   `(isearch-fail ((t (:background ,error :foreground ,canvas))))
   `(lazy-highlight ((t (:background ,selection :foreground ,accent-bright))))
   `(trailing-whitespace ((t (:background ,error))))
   `(escape-glyph ((t (:foreground ,hot))))
   `(nobreak-space ((t (:foreground ,hot :underline t))))
   `(show-paren-match ((t (:background ,selection :foreground ,accent :weight bold))))
   `(show-paren-mismatch ((t (:background ,error :foreground ,canvas))))
   `(mode-line ((t (:background ,surface :foreground ,text
                   :box (:line-width 1 :color ,structure)))))
   `(mode-line-active ((t (:inherit mode-line))))
   `(mode-line-inactive ((t (:background ,surface :foreground ,muted
                            :box (:line-width 1 :color ,border)))))
   `(mode-line-buffer-id ((t (:foreground ,accent :weight bold))))
   `(header-line ((t (:background ,surface :foreground ,muted :box nil))))
   `(tab-bar ((t (:background ,surface :foreground ,muted))))
   `(tab-bar-tab ((t (:background ,raised :foreground ,accent :weight bold))))
   `(tab-bar-tab-inactive ((t (:background ,surface :foreground ,muted))))
   `(tooltip ((t (:background ,raised :foreground ,text))))
   `(completions-common-part ((t (:foreground ,accent :weight bold))))
   `(completions-first-difference ((t (:foreground ,hot))))
   `(completions-highlight ((t (:background ,selection :foreground ,text))))
   `(font-lock-builtin-face ((t (:foreground ,accent-bright))))
   `(font-lock-comment-face ((t (:foreground ,comment :slant italic))))
   `(font-lock-comment-delimiter-face ((t (:inherit font-lock-comment-face))))
   `(font-lock-doc-face ((t (:foreground ,comment :slant italic))))
   `(font-lock-doc-markup-face ((t (:foreground ,accent-bright))))
   `(font-lock-constant-face ((t (:foreground ,hot))))
   `(font-lock-number-face ((t (:foreground ,hot))))
   `(font-lock-function-name-face ((t (:foreground ,accent))))
   `(font-lock-function-call-face ((t (:foreground ,accent))))
   `(font-lock-keyword-face ((t (:foreground ,purple))))
   `(font-lock-type-face ((t (:foreground ,info))))
   `(font-lock-string-face ((t (:foreground ,warning))))
   `(font-lock-regexp-face ((t (:foreground ,error))))
   `(font-lock-variable-name-face ((t (:foreground ,text))))
   `(font-lock-variable-use-face ((t (:foreground ,text))))
   `(font-lock-property-name-face ((t (:foreground ,accent-bright))))
   `(font-lock-property-use-face ((t (:foreground ,accent-bright))))
   `(font-lock-operator-face ((t (:foreground ,accent-bright))))
   `(font-lock-preprocessor-face ((t (:foreground ,hot))))
   `(font-lock-negation-char-face ((t (:foreground ,accent-bright))))
   `(font-lock-punctuation-face ((t (:foreground ,muted))))
   `(font-lock-bracket-face ((t (:foreground ,muted))))
   `(font-lock-delimiter-face ((t (:foreground ,muted))))
   `(font-lock-warning-face ((t (:foreground ,warning :weight bold))))
   `(flymake-error ((t (:underline (:style wave :color ,error)))))
   `(flymake-warning ((t (:underline (:style wave :color ,warning)))))
   `(flymake-note ((t (:underline (:style wave :color ,info)))))
   `(diff-added ((t (:foreground ,success))))
   `(diff-removed ((t (:foreground ,error))))
   `(diff-changed ((t (:foreground ,warning))))
   `(diff-header ((t (:background ,surface :foreground ,info))))
   `(diff-file-header ((t (:background ,raised :foreground ,accent :weight bold))))
   `(diff-hunk-header ((t (:background ,surface :foreground ,purple))))
   `(diff-refine-added ((t (:background ,selection :foreground ,success))))
   `(diff-refine-removed ((t (:background ,selection :foreground ,error))))))

(provide-theme 'neon-flux)
(provide 'neon-flux-theme)

;;; neon-flux-theme.el ends here
